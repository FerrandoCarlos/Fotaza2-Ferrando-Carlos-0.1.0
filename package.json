{
  "name": "fotaza2-0.1.0",
  "version": "1.0.0",
  "description": "Comunidad web para compartir y gestionar imágenes.\r Desarrollado para la cátedra **Programación Web II**.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"node --watch app.js\" \"npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch\"",
    "build": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --minify",
    "db:init": "node src/utils/dbInit.js",
    "seed": "node src/utils/seed.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FerrandoCarlos/Fotaza2-Ferrando-Carlos-0.1.0.git"
  },
  "keywords": [],
  "author": "Ferrando Carlos",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/FerrandoCarlos/Fotaza2-Ferrando-Carlos-0.1.0/issues"
  },
  "homepage": "https://github.com/FerrandoCarlos/Fotaza2-Ferrando-Carlos-0.1.0#readme",
  "dependencies": {
    "@tailwindcss/cli": "4.3.0",
    "bcrypt": "6.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "pg": "8.20.0",
    "pg-hstore": "2.3.4",
    "pug": "3.0.4",
    "sequelize": "6.37.8",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
