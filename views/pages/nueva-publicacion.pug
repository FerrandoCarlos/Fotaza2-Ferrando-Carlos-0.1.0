extends ../layout.pug

block content
  include ../mixins/input.pug
  include ../mixins/button.pug
  include ../mixins/alert.pug

  section(class="max-w-2xl mx-auto px-8 - py-12")
    a(class="block text-amber-400 hover:underline text-sm mb-6" href="/") ← Volver al inicio
    h1(class="text-3xl font-bold text-amber-400 mb-8") Nueva publicación

    +alert(alert)

    form(action="/publicacion" method="post" class="bg-zinc-900 rounded-xl p-8 flex flex-col gap-5")
      +input('Titulo','titulo','text','titulo','Titulo de la publicación',formValues ? formValues.titulo : '')

      div
        label(for="descripcion" class="block text-sm text-gray-400 mb-1") Descripción
        textarea#descripcion(
          name="descripcion"
          placeholder="Descripción opcional"
          rows="3"
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400 resize-none"
        ) #{formValues ? formValues.descripcion : ''}

      div
        label(for="imagen" class="block text-sm text-gray-400 mb-1") Imagen
        input#imagen(
          type="file"
          name="imagen"
          accept="image/*"
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )
        img#preview(
          class=(formValues && formValues.imgBase64 ? "mt-3 w-full max-h-64 object-cover rounded-lg" : "hidden mt-3 w-full max-h-64 object-cover rounded-lg")
          src=(formValues && formValues.imgBase64 ? `data:${formValues.mimeType};base64,${formValues.imgBase64}` : '')
        )
        input#imgBase64(type="hidden" name="imgBase64" value=formValues ? formValues.imgBase64 : '')
        input#mimeType(type="hidden" name="mimeType" value=formValues ? formValues.mimeType : '')

      div
        label(for="licencia_id" class="block text-sm text-gray-400 mb-1") Licencia
        select#licencia_id(
          name="licencia_id"
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )
          each licencia in licencias
            option(value=licencia.id) #{licencia.nombre}

      div
        label(for="marca_agua" class="block text-sm text-gray-400 mb-1") Marca de agua
          span(class="text-gray-600 text-xs p-1") (solo para imágenes con copyright)
        input#marca_agua(
          type="text"
          name="marca_agua_texto"
          placeholder=`Ej: © Tu nombre`
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )

      div
        label(class="block text-sm text-gray-400 mb-2") Etiquetas
        div(class="flex flex-wrap gap-2")
          each etiqueta in etiquetas
            label(class="flex items-center gap-2 cursor-pointer")
              input(type="checkbox" name="etiquetas" value=etiqueta.id class="accent-amber-400")
              span(class="text-gray-300 text-sm") #{etiqueta.nombre}

      +btnPrimario('Publicar')
    script(src="/js/upload.js")
