extends ../layout.pug

block content
  include ../mixins/input.pug
  include ../mixins/alert.pug
  include ../mixins/button.pug

  section(class="max-w-2xl mx-auto px-8 py-12")
    a(class="block text-amber-400 hover:underline text-sm mb-6" href="/") ← Volver al inicio
    h1(class="text-3xl font-bold text-amber-400 mb-8") Editar publicación

    +alert(alert)

    form(action=`/publicacion/editar/${publicacion.id}` method="post" class="bg-zinc-900 rounded-xl p-8 flex flex-col gap-5")
      +input('Titulo', 'titulo', 'text', 'titulo', 'Titulo de la publicación',publicacion.titulo)

       div
        label(for="descripcion" class="block text-sm text-gray-400 mb-1") Descripción
        textarea#descripcion(
          name="descripcion"
          placeholder="Descripción opcional"
          rows="3"
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400 resize-none"
        ) #{publicacion.descripcion || ''}

      div
        label(for="imagen" class="block text-sm text-gray-400 mb-1") Imagen actual
        if publicacion.Imagens && publicacion.Imagens.length
          img(class="w-full max-h-48 object-cover rounded-lg mb-3" src=`data:${publicacion.Imagens[0].mimeType};base64,${publicacion.Imagens[0].datos}` alt=publicacion.titulo)
        label(for="imagen" class="block text-sm text-gray-400 mb-1") Cambiar imagen (opcional)
        input#imagen(
          type="file"
          name="imagen"
          accept="image/*"
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )
        img#preview(class="hidden mt-3 w-full max-h-64 object-cover rounded-lg")
        input#imgBase64(type="hidden" name="imgBase64" value=publicacion.Imagens[0].datos)
        input#mimeType(type="hidden" name="mimeType" value=publicacion.Imagens[0].mimeType)

      div
        label(for="licencia_id" class="block text-sm text-gray-400 mb-1") Licencia
        select#licencia_id(
          name="licencia_id"
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )
          each licencia in licencias
            option(value=licencia.id selected=publicacion.Imagens[0].licencia_id == licencia.id) #{licencia.nombre}

      div
        label(for="marca_agua" class="block text-sm text-gray-400 mb-1") Marca de agua
          span(class="text-gray-600 text-xs") (solo para imágenes con copyright)
        input#marca_agua(
          type="text"
          name="marca_agua_texto"
          placeholder="Ej: © Tu nombre"
          value=publicacion.Imagens[0].marca_agua_texto || ''
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )

      div
        label(class="block text-sm text-gray-400 mb-1") Etiquetas
          span(class="text-gray-600 text-xs ml-1") (separadas por coma, se crean si no existen)
        input#etiquetasInput(
          type="text"
          name="etiquetasTexto"
          placeholder="naturaleza, paisaje, retrato..."
          value=publicacion.Etiqueta ? publicacion.Etiqueta.map(e => e.nombre).join(', ') : ''
          class="w-full bg-zinc-800 border border-zinc-700 text-gray-100 rounded-lg px-4 py-2 focus:outline-none focus:border-amber-400"
        )

      +btnPrimario('Guardar cambios')

    script(src="/js/upload.js")
