include ../mixins/input.pug
include ../mixins/button.pug
include ../mixins/alert.pug

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
    link(rel="stylesheet", href="/css/output.css")
  body(class="bg-zinc-950 text-gray-100 min-h-screen flex flex-col")

    section(class="flex items-center justify-center py-16 px-4")
      div(class="w-full max-w-md")
        h1(class="text-3xl font-bold text-amber-400 text-center mb-8") Crear cuenta

        form(action="/register" method="POST" class="bg-zinc-900 rounded-xl p-8 flex flex-col gap-5")

          +input('Nombre', 'nombre', 'text', 'nombre', 'Ingresa tu nombre', formValues ? formValues.nombre : '')
          +input('Apellido', 'apellido', 'text', 'apellido', 'Ingresa tu apellido', formValues ? formValues.apellido : '')
          +input('Email', 'email', 'email', 'email', 'example@email.com', formValues ? formValues.email : '')
          +input('Contraseña', 'password', 'password', 'password', 'Mínimo 8 caracteres','')
          +input('Confirmar contraseña', 'comfirPassword','password','confirmPassword','Repetí tu contraseña', '')
          +btnPrimario('Registrarse')

          p(class="text-gray-500 text-sm text-center")
            span(class="mr-1") ¿Ya tenes cuenta?
            a(class="text-amber-400 hover:underline" href="/login") Inicia sesión
