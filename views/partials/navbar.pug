
header(class="bg-zinc-900 border-b border-zinc-800")
  nav(class="max-w-7xl mx-auto h-16 px-8 flex items-center justify-between"  aria-label="Navegación principal")
    //- Logo
    a(class="flex items-center shrink-0" href="/")
      img(class="h-10 w-auto" src="/img/logoNav.png" alt="Fotaza 2")
    //- Buscador Escritorio
    form(action="/" method="get" class="relative hidden sm:flex items-center w-full max-w-xs md:max-w-md mx-auto px-4")
      svg(class="absolute left-7 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
        circle(cx="11" cy="11" r="8")
        path(d="m21 21-4.35-4.35")
      input(
        type="text"
        name="search"
        placeholder="Buscar publicaciones..."
        value=queryActual || ''
        class="w-full bg-zinc-800/60 text-gray-200 pl-10 pr-4 py-2 rounded-full text-sm border border-zinc-700 focus:outline-none focus:border-amber-400 focus:bg-zinc-800 transition-all placeholder-zinc-500"
      )
      div(class="absolute left-3 top-2.5 text-gray-500 text-xs")

    //- Menú de escritorio
    div(class="hidden sm:flex items-center gap-8 shrink-0")
      a(class="text-gray-400 hover:text-amber-400 transition-colors text-sm font-medium" href="/") Inicio
      if currentUser
        //- Botón nueva publicación
        a(class="bg-amber-400 text-zinc-950 text-sm font-semibold px-4 py-2 rounded-lg hover:bg-amber-300 transition-colors" href="/publicacion/nueva") + Publicar
        a(href="/perfil" class="flex items-center gap-2")
          if currentUser.avatar_url
            img(class="w-8 h-8 rounded-full object-cover" src=currentUser.avatar_url)
          else
            span(class="w-8 h-8 rounded-full bg-amber-400 text-zinc-950 text-sm font-bold flex items-center justify-center") #{currentUser.nombre[0].toUpperCase()}#{currentUser.apellido[0].toUpperCase()}
        a(class="text-gray-400 hover:text-amber-400 transition-colors text-sm font-medium" href="/logout") Cerrar sesión
      else
        a(class="text-gray-400 hover:text-amber-400 transition-colors text-sm font-medium" href="/login") Ingresar
        a(class="bg-amber-400 text-zinc-950 text-sm font-semibold px-4 py-2 rounded-lg hover:bg-amber-300 transition-colors" href="/register") Registrarse
    //- Botón Hamburguesa (mobile)
    div(class="sm:hidden")
      button#navbar-toggle(
        class="size-9 flex justify-center items-center rounded-lg bg-zinc-800 border border-zinc-700 text-gray-400 hover:bg-zinc-700 hover:text-amber-400 transition-colors focus:outline-none"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="navbar-menu"
      )
        svg#icon-open(class="size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
		stroke="currentColor" stroke-width="2" aria-hidden="true")
          line(x1="3" y1="6" x2="21" y2="6")
          line(x1="3" y1="12" x2="21" y2="12")
          line(x1="3" y1="18" x2="21" y2="18")
        svg#icon-close(class="hidden size-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
		stroke="currentColor" stroke-width="2" aria-hidden="true")
          path(d="M18 6 6 18")
          path(d="m6 6 12 12")
  //- Menú desplegable (mobile)
  div#navbar-menu(class="hidden sm:hidden border-t border-zinc-800")
    div(class="flex flex-col px-8 py-4 gap-4")
      //- Buscador Mobile
      form(action="/" method="get" class="relative w-full mb-2")
        svg(class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
        circle(cx="11" cy="11" r="8")
        path(d="m21 21-4.35-4.35")
        input(
          type="text"
          name="search"
          placeholder="Buscar publicaciones..."
          value=queryActual || ''
          class="w-full bg-zinc-800/60 text-gray-200 pl-10 pr-4 py-2 rounded-full text-sm border border-zinc-700 focus:outline-none focus:border-amber-400 transition-all placeholder-zinc-500"
        )

      a(class="text-gray-400 hover:text-amber-400 transition-colors text-sm font-medium" href="/") Inicio
      if currentUser
        a(class="bg-amber-400 text-zinc-950 text-sm font-semibold px-4 py-2 rounded-lg hover:bg-amber-300 transition-colors text-center" href="/publicacion/nueva") + Publicar
        span(class="text-amber-400 text-sm font-medium") #{currentUser.nombre}
        a(class="text-gray-400 hover:text-amber-400 transition-colors text-sm font-medium" href="/logout") Cerrar sesión
      else
        a(class="text-gray-400 hover:text-amber-400 transition-colors text-sm font-medium" href="/login") Ingresar
        a(class="text-amber-400 font-semibold text-sm" href="/register") Registrarse
